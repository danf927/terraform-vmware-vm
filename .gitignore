# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive data - NEVER commit)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .tfvars files EXCEPT the spec templates (which use SET_FROM_SCRIPT placeholders)
# Only exclude actual .tfvars files that get generated/modified during runs
*.auto.tfvars
*.auto.tfvars.json

# Allow the spec template files (these are safe to commit - they use placeholders)
!windows-2025.tfvars
!linux-dev.tfvars
!linux-prod.tfvars
!linux-staging.tfvars

# Ignore override files (local development)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

# Ignore lock files (optional for modules, but keep them in version control for reproducibility)
# .terraform.lock.hcl
